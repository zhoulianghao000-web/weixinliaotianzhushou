# 复制为 .env 后按需修改（.env 不要提交到 git）
# 全部变量说明见 CLAUDE.md §9

# ---- LLM（DeepSeek / OpenAI 兼容）----
# 留空则走本地规则模板兜底，功能仍可用
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ---- 服务 ----
SIDEBAR_HOST=127.0.0.1
SIDEBAR_PORT=8765

# ---- 侧边栏窗口 ----
# 注意：改名必须同步，services/docker.py 靠标题找窗口句柄
SIDEBAR_TITLE=WeChat Sidebar
SIDEBAR_WIDTH=380

# ---- 采集适配器：auto / qq / wechat4 / wxauto / mock ----
SIDEBAR_ADAPTER=auto

# 贴边跟随的目标 IM 窗口：先按类名精确匹配，找不到再按窗口标题匹配。
# auto 会依据当前前台窗口选择 QQ 或微信 4.x；手动选择时会按平台分别定位窗口。
SIDEBAR_TARGET_CLASS=
SIDEBAR_TARGET_TITLE=QQ

# ---- 数据库（默认 项目根/data/sidebar.db）----
# SIDEBAR_DB=C:/Users/zl/CodeBuddy/20261020170527/wechat-sidebar/data/sidebar.db
